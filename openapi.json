{
  "openapi": "3.0.0",
  "info": {
    "title": "Campaign Service",
    "description": "API for managing marketing campaigns",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3003"
    }
  ],
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Service API key (CAMPAIGN_SERVICE_API_KEY)"
      }
    },
    "schemas": {
      "Campaign": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "orgId": {
            "type": "string"
          },
          "createdByUserId": {
            "type": "string",
            "nullable": true
          },
          "parentRunId": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string"
          },
          "workflowSlug": {
            "type": "string"
          },
          "brandIds": {
            "type": "array",
            "nullable": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "featureSlug": {
            "type": "string",
            "nullable": true
          },
          "featureInputs": {
            "type": "object",
            "nullable": true,
            "additionalProperties": {
              "nullable": true
            }
          },
          "maxBudgetDailyUsd": {
            "type": "string",
            "nullable": true
          },
          "maxBudgetWeeklyUsd": {
            "type": "string",
            "nullable": true
          },
          "maxBudgetMonthlyUsd": {
            "type": "string",
            "nullable": true
          },
          "maxBudgetTotalUsd": {
            "type": "string",
            "nullable": true
          },
          "maxLeads": {
            "type": "integer",
            "nullable": true
          },
          "startDate": {
            "type": "string",
            "nullable": true
          },
          "endDate": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string"
          },
          "toResumeAt": {
            "type": "string",
            "nullable": true
          },
          "notifyFrequency": {
            "type": "string",
            "nullable": true
          },
          "notifyChannel": {
            "type": "string",
            "nullable": true
          },
          "notifyDestination": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "orgId",
          "createdByUserId",
          "parentRunId",
          "name",
          "workflowSlug",
          "brandIds",
          "featureSlug",
          "featureInputs",
          "maxBudgetDailyUsd",
          "maxBudgetWeeklyUsd",
          "maxBudgetMonthlyUsd",
          "maxBudgetTotalUsd",
          "maxLeads",
          "startDate",
          "endDate",
          "status",
          "toResumeAt",
          "notifyFrequency",
          "notifyChannel",
          "notifyDestination",
          "createdAt",
          "updatedAt"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "CreateCampaignBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "workflowSlug": {
            "type": "string",
            "minLength": 1
          },
          "orgId": {
            "type": "string",
            "minLength": 1
          },
          "brandIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "minItems": 1
          },
          "featureSlug": {
            "type": "string",
            "minLength": 1
          },
          "featureInputs": {
            "type": "object",
            "additionalProperties": {
              "nullable": true
            }
          },
          "maxBudgetDailyUsd": {
            "type": "string"
          },
          "maxBudgetWeeklyUsd": {
            "type": "string"
          },
          "maxBudgetMonthlyUsd": {
            "type": "string"
          },
          "maxBudgetTotalUsd": {
            "type": "string"
          },
          "maxLeads": {
            "type": "integer"
          },
          "startDate": {
            "type": "string"
          },
          "endDate": {
            "type": "string"
          },
          "notifyFrequency": {
            "type": "string"
          },
          "notifyChannel": {
            "type": "string"
          },
          "notifyDestination": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "workflowSlug",
          "orgId",
          "brandIds"
        ]
      },
      "UpdateCampaignBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "brandIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "featureSlug": {
            "type": "string",
            "minLength": 1
          },
          "featureInputs": {
            "type": "object",
            "additionalProperties": {
              "nullable": true
            }
          },
          "maxBudgetDailyUsd": {
            "type": "string"
          },
          "maxBudgetWeeklyUsd": {
            "type": "string"
          },
          "maxBudgetMonthlyUsd": {
            "type": "string"
          },
          "maxBudgetTotalUsd": {
            "type": "string"
          },
          "maxLeads": {
            "type": "integer"
          },
          "startDate": {
            "type": "string"
          },
          "endDate": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "activate",
              "stop"
            ]
          },
          "notifyFrequency": {
            "type": "string"
          },
          "notifyChannel": {
            "type": "string"
          },
          "notifyDestination": {
            "type": "string"
          }
        }
      },
      "StatsResponse": {
        "type": "object",
        "properties": {
          "stats": {
            "$ref": "#/components/schemas/StatsEntry"
          }
        },
        "required": [
          "stats"
        ]
      },
      "StatsEntry": {
        "type": "object",
        "properties": {
          "totalCampaigns": {
            "type": "number"
          },
          "byStatus": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "budgetTotalUsd": {
            "type": "number",
            "nullable": true
          },
          "maxLeadsTotal": {
            "type": "number",
            "nullable": true
          }
        },
        "required": [
          "totalCampaigns",
          "byStatus",
          "budgetTotalUsd",
          "maxLeadsTotal"
        ]
      },
      "GroupedStatsResponse": {
        "type": "object",
        "properties": {
          "groupedStats": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/StatsEntry"
            }
          }
        },
        "required": [
          "groupedStats"
        ]
      },
      "StatsGroupByEnum": {
        "type": "string",
        "enum": [
          "workflowSlug",
          "featureSlug"
        ]
      },
      "BatchBudgetUsageBody": {
        "type": "object",
        "properties": {
          "campaignIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "required": [
          "campaignIds"
        ]
      },
      "GateCheckResponse": {
        "type": "object",
        "properties": {
          "allowed": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "autoStopped": {
            "type": "boolean"
          }
        },
        "required": [
          "allowed"
        ]
      },
      "StartRunResponse": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string",
            "format": "uuid"
          },
          "campaignId": {
            "type": "string",
            "format": "uuid"
          },
          "orgId": {
            "type": "string"
          },
          "brandIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "workflowSlug": {
            "type": "string"
          },
          "userId": {
            "type": "string",
            "nullable": true
          },
          "featureSlug": {
            "type": "string",
            "nullable": true
          },
          "featureInputs": {
            "type": "object",
            "nullable": true,
            "additionalProperties": {
              "nullable": true
            }
          },
          "searchParams": {
            "type": "object",
            "nullable": true,
            "additionalProperties": {
              "nullable": true
            }
          }
        },
        "required": [
          "runId",
          "campaignId",
          "orgId",
          "brandIds",
          "workflowSlug",
          "userId",
          "featureSlug",
          "featureInputs",
          "searchParams"
        ]
      },
      "EndRunResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "EndRunBody": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "stopCampaign": {
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "stopCampaign"
        ]
      },
      "TransferBrandResponse": {
        "type": "object",
        "properties": {
          "updatedTables": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tableName": {
                  "type": "string"
                },
                "count": {
                  "type": "integer"
                }
              },
              "required": [
                "tableName",
                "count"
              ]
            }
          }
        },
        "required": [
          "updatedTables"
        ]
      },
      "TransferBrandBody": {
        "type": "object",
        "properties": {
          "sourceBrandId": {
            "type": "string",
            "format": "uuid"
          },
          "sourceOrgId": {
            "type": "string",
            "minLength": 1
          },
          "targetOrgId": {
            "type": "string",
            "minLength": 1
          },
          "targetBrandId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "sourceBrandId",
          "sourceOrgId",
          "targetOrgId"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "service": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "service"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/health/debug": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Debug health check with DB status",
        "responses": {
          "200": {
            "description": "Debug info",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "dbUrlConfigured": {
                      "type": "boolean"
                    },
                    "dbStatus": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "dbUrlConfigured",
                    "dbStatus"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/campaigns": {
      "get": {
        "tags": [
          "Campaigns"
        ],
        "summary": "List campaigns for org",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "brandId",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "workflowSlug",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "featureSlug",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "List of campaigns",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "campaigns": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Campaign"
                      }
                    }
                  },
                  "required": [
                    "campaigns"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Campaigns"
        ],
        "summary": "Create a new campaign",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCampaignBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Campaign created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "campaign": {
                      "$ref": "#/components/schemas/Campaign"
                    }
                  },
                  "required": [
                    "campaign"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/campaigns/{id}": {
      "get": {
        "tags": [
          "Campaigns"
        ],
        "summary": "Get a specific campaign",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Campaign details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "campaign": {
                      "$ref": "#/components/schemas/Campaign"
                    }
                  },
                  "required": [
                    "campaign"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Campaigns"
        ],
        "summary": "Update a campaign",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCampaignBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Campaign updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "campaign": {
                      "$ref": "#/components/schemas/Campaign"
                    }
                  },
                  "required": [
                    "campaign"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Campaigns"
        ],
        "summary": "Delete a campaign",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Campaign deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/stats": {
      "get": {
        "tags": [
          "Stats"
        ],
        "summary": "Campaign stats from own DB (query params)",
        "description": "Returns campaign counts, status breakdown, and configured budget totals. Supports filtering by workflowSlug, featureSlug, and groupBy for aggregation by slug. When groupBy is set, returns groupedStats keyed by the group value. Requires API key.",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "orgId",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "brandId",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "campaignId",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "workflowSlug",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "featureSlug",
            "in": "query"
          },
          {
            "schema": {
              "$ref": "#/components/schemas/StatsGroupByEnum"
            },
            "required": false,
            "name": "groupBy",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Campaign stats (flat or grouped)",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/StatsResponse"
                    },
                    {
                      "$ref": "#/components/schemas/GroupedStatsResponse"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/stats/batch-budget": {
      "post": {
        "tags": [
          "Stats"
        ],
        "summary": "Get cost data for multiple campaigns",
        "description": "Returns budget usage (totalCostInUsdCents) per campaign via runs-service.",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchBudgetUsageBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stats per campaign",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string"
                          },
                          "maxLeads": {
                            "type": "number",
                            "nullable": true
                          },
                          "maxBudgetTotalUsd": {
                            "type": "string",
                            "nullable": true
                          },
                          "totalCostInUsdCents": {
                            "type": "string",
                            "nullable": true
                          },
                          "error": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "required": [
                    "results"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/campaigns/list": {
      "get": {
        "tags": [
          "Scheduler"
        ],
        "summary": "List all campaigns across all orgs",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "All campaigns with org info",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "campaigns": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Campaign"
                      }
                    }
                  },
                  "required": [
                    "campaigns"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/gate-check": {
      "post": {
        "tags": [
          "Pipeline"
        ],
        "summary": "Check if a campaign can run a new iteration",
        "description": "Validates budget limits (daily/weekly/monthly/total) via runs-service stats/budget, volume limits (maxLeads), campaign status, and consecutive failures. Auto-stops the campaign if total budget or maxLeads is exceeded. Called as the first DAG node.",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Organization UUID (required)"
            },
            "required": true,
            "description": "Organization UUID (required)",
            "name": "x-org-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Campaign UUID (required)"
            },
            "required": true,
            "description": "Campaign UUID (required)",
            "name": "x-campaign-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "description": "User UUID (required)"
            },
            "required": true,
            "description": "User UUID (required)",
            "name": "x-user-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "description": "Parent run UUID (required)"
            },
            "required": true,
            "description": "Parent run UUID (required)",
            "name": "x-run-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
