{
  "name": "campaign-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --import ./src/instrument.ts src/index.ts",
    "build": "pnpm run build:packages && tsc && pnpm generate:openapi",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "build:packages": "pnpm --filter ./packages/** run build",
    "start": "node --import ./dist/instrument.js dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "check:migrations": "tsx scripts/check-migrations.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.4.0",
    "@clerk/backend": "^1.0.0",
    "@distribute/runs-client": "workspace:*",
    "@sentry/node": "^8.0.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.36.0",
    "express": "^4.21.0",
    "postgres": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "^0.28.0",
    "supertest": "^7.2.2",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "rollup@^4.0.0": "^4.59.0",
      "path-to-regexp@^0.1.0": "^0.1.13",
      "picomatch@^4.0.0": "^4.0.4",
      "vite@^7.0.0": "^7.3.7",
      "@clerk/shared@^3.0.0": "^3.47.5",
      "js-cookie@^3.0.0": "^3.0.6",
      "form-data@^4.0.0": "^4.0.6",
      "postcss@^8.0.0": "^8.5.18",
      "nanoid@^3.0.0": "^3.3.18",
      "source-map-js@^1.0.0": "^1.2.2",
      "proxy-addr@^2.0.0": "^2.0.8"
    }
  }
}
